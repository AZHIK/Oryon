# ─────────────────────────────────────────────────────────────
# Oryon Foods production environment (non-secret values)
# Copy to `.env`, then edit every value marked REPLACE/example.com.
# Secret values live in `secrets/` and are generated by bootstrap.sh.
#
# Quote any value containing spaces so the deploy scripts can source this
# file safely. Docker Compose strips the quotes.
# ─────────────────────────────────────────────────────────────

# Public DNS names. Point these at the VPS before the first start.
AUTH_HOST=auth.example.com
INVENTORY_HOST=inventory.example.com
POS_HOST=pos.example.com

# Let's Encrypt registration address.
ACME_EMAIL=ops@example.com

# Exact browser origin(s) of the web app. Mobile clients do not need CORS.
CORS_ALLOWED_ORIGINS="https://app.example.com"

# Comma-separated CIDRs allowed to reach admin/platform paths.
# 127.0.0.1/32 denies every public request until you add your office/VPN.
ADMIN_ALLOWLIST="127.0.0.1/32"

# ── Container images ─────────────────────────────────────────
# Application images are built and pushed by CI. Use an immutable sha-* tag.
IMAGE_REGISTRY=ghcr.io/azhik
IMAGE_TAG=sha-REPLACE

# Infrastructure images. Pin these to digests (repo@sha256:...) for a fully
# immutable production stack; the defaults below are only a starting point.
TRAEFIK_IMAGE=traefik:v3.1
SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:0.2
POSTGRES_IMAGE=postgres:16.4-alpine
REDIS_IMAGE=redis:7.4-alpine

# ── Notification providers (non-secret) ──────────────────────
SMS_PROVIDER=africastalking
AT_USERNAME=REPLACE
AT_SENDER_ID=ORYON

EMAIL_PROVIDER=brevo
BREVO_FROM_EMAIL=no-reply@example.com
BREVO_FROM_NAME="Oryon Foods"

WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v21.0

# ── First platform administrator ─────────────────────────────
# The password is kept in secrets/admin_password, generated by bootstrap.
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME="Platform Administrator"

# ── Encrypted offsite backups (restic) ───────────────────────
# Examples:
#   b2:oryonfoods-backups:vps01
#   s3:https://s3.eu-central-003.backblazeb2.com/oryonfoods-backups
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/opt/oryonfoods/secrets/restic_password
B2_ACCOUNT_ID_FILE=/opt/oryonfoods/secrets/b2_account_id
B2_ACCOUNT_KEY_FILE=/opt/oryonfoods/secrets/b2_account_key

# Optional dead-man's-switch ping after a successful backup.
BACKUP_HEALTHCHECK_URL=

# Set to 1 only if you intentionally want secrets included in the restic
# snapshot (the repository is encrypted; keep its password offline).
BACKUP_SECRETS=0
