# ──────────────────────────────────────────────
# Oryon Foods Inventory Service — Environment Variables
# ──────────────────────────────────────────────
# Copy to .env and fill in real values for local dev.
# Docker Compose reads this file automatically.

# ── App ────────────────────────────────────────
ENVIRONMENT=local                          # local | dev | staging | prod
DEBUG=true
SERVICE_NAME=inventory-service
LOG_LEVEL=DEBUG                            # DEBUG | INFO | WARNING | ERROR

# ── PostgreSQL ────────────────────────────────
DB_URL=postgresql+asyncpg://oryonfoods:oryonfoods@localhost:5434/oryonfoods_inventory

# Separate test database — used by the test suite (real alembic upgrade head).
# Leave unset for normal dev; the test suite sets it explicitly.
TEST_DB_URL=postgresql+asyncpg://oryonfoods:oryonfoods@localhost:5434/oryonfoods_inventory_test

# ── JWT (public key only — verify tokens, never issue them) ──
# Local/dev uses the repo copy. Production mounts the public key read-only
# (e.g. /run/secrets/jwt_public.pem) and sets this accordingly.
JWT_PUBLIC_KEY_PATH=keys/public.pem

# ── Service-to-service auth ───────────────────
# Shared secret for internal POS → Inventory calls. The dev default is
# rejected in production; use at least 32 random characters there.
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# ── CORS ──────────────────────────────────────
# Comma-separated exact origins. Production startup refuses '*' and
# localhost origins (SEC-02).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── RabbitMQ (shared event bus) ───────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EVENTS_EXCHANGE=oryonfoods.events

# ── Host ──────────────────────────────────────
HOST=0.0.0.0
PORT=8100

# ── WhatsApp Business Cloud API ──────────────
# Graph API base + version for outbound PO sends (per-business credentials
# live in the whatsappconnection table, managed from the app's Settings).
# WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
# WHATSAPP_GRAPH_VERSION=v21.0
# Required in production. Enables X-Hub-Signature-256 webhook checks; without
# it every inbound webhook is rejected (SEC-04).
WHATSAPP_APP_SECRET=
# Global fallback token for webhook GET verification.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Public HTTPS base URL used to render the webhook URL in Settings.
PUBLIC_BASE_URL=https://inventory.example.com