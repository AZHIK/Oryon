# ──────────────────────────────────────────────
# Oryon Foods POS Service — Environment Variables
# ──────────────────────────────────────────────
# Copy to .env and fill in real values for local dev.
# Docker Compose reads this file automatically.

# ── App ────────────────────────────────────────
ENVIRONMENT=local                          # local | dev | staging | prod
DEBUG=true
SERVICE_NAME=pos-service
LOG_LEVEL=DEBUG                            # DEBUG | INFO | WARNING | ERROR

# ── PostgreSQL ────────────────────────────────
DB_URL=postgresql+asyncpg://oryonfoods:oryonfoods@localhost:5435/oryonfoods_pos

# ── JWT (public key only — verify tokens, never issue them) ──
# Local/dev uses the repo copy. Production mounts the public key read-only
# (e.g. /run/secrets/jwt_public.pem) and sets this accordingly.
JWT_PUBLIC_KEY_PATH=keys/public.pem
# Required in production; must match Identity Service exactly.
# JWT_ISSUER=https://auth.example.com
# JWT_AUDIENCE=oryonfoods-api
# JWT_KEY_ID=primary

# ── Service-to-service calls ──────────────────
# Must match Inventory's INTERNAL_SERVICE_TOKEN. The dev default is rejected
# in production; use at least 32 random characters there.
INTERNAL_SERVICE_TOKEN=change-me-internal-token
# Docker service names in the compose network; production domains only if
# calls leave the private network (prefer service names).
INVENTORY_SERVICE_URL=http://localhost:8100/api/v1
IDENTITY_SERVICE_URL=http://localhost:8009/api/v1

# ── CORS ──────────────────────────────────────
# Comma-separated exact origins. Production startup refuses '*' and
# localhost origins (SEC-02).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── RabbitMQ (shared event bus) ───────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EVENTS_EXCHANGE=oryonfoods.events

# ── POS ────────────────────────────────────────
TIME_DRIFT_SUSPECT_THRESHOLD_HOURS=48
TIME_DRIFT_FUTURE_TOLERANCE_MINUTES=5
DEFAULT_TAX_RATE=0

# ── Finance / receipt storage ─────────────────
RECEIPT_STORAGE_ROOT=/var/lib/oryonfoods/receipts
RECEIPT_MAX_BYTES=5242880

# ── Host ──────────────────────────────────────
HOST=0.0.0.0
PORT=8200
