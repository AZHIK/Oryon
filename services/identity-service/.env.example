# ──────────────────────────────────────────────
# Oryon Foods Auth Service — Environment Variables
# ──────────────────────────────────────────────
# Copy to .env and fill in real values for local dev.
# Docker Compose reads this file automatically.

# ── App ────────────────────────────────────────
ENVIRONMENT=local                          # local | dev | staging | prod
DEBUG=true
APP_NAME=Oryon Foods Auth
LOG_LEVEL=DEBUG                            # DEBUG | INFO | WARNING | ERROR

# ── PostgreSQL ────────────────────────────────
DB_URL=postgresql+asyncpg://oryonfoods:oryonfoods@localhost:5455/oryonfoods_auth

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6385/0

# ── JWT (placeholder — generate RSA keys later) ─
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
# Required in production; the deploy stack sets all three consistently across
# Identity, Inventory, and POS.
# JWT_ISSUER=https://auth.example.com
# JWT_AUDIENCE=oryonfoods-api
# JWT_KEY_ID=primary

# ── OTP / SMS delivery ────────────────────────
# console logs the full OTP message to stdout (see sms_console_send in the
# API logs) — perfect for local manual testing without a real SMS gateway.
# africastalking | console
SMS_PROVIDER=console
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Africa's Talking credentials (only needed when SMS_PROVIDER=africastalking)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# ── Email OTP delivery ────────────────────────
# console logs the full OTP email to stdout — perfect for local manual
# testing without a mail provider. Use brevo in deployed environments.
# console | brevo | mailjet
EMAIL_PROVIDER=console

# Brevo → Settings → SMTP & API → API Keys (starts with "xkeysib-").
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@oryonfoods.com
BREVO_FROM_NAME=Oryon Foods
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_TIMEOUT_SECONDS=15

# Mailjet (alternative provider, set EMAIL_PROVIDER=mailjet to use it).
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=no-reply@oryonfoods.com
MAILJET_FROM_NAME=Oryon Foods
MAILJET_API_URL=https://api.mailjet.com/v3.1/send
MAILJET_TIMEOUT_SECONDS=15

# ── CORS ──────────────────────────────────────
# Comma-separated exact origins. Production startup refuses '*' and
# localhost origins (SEC-02).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Session ───────────────────────────────────
SESSION_TTL_MINUTES=60

# ── Production checklist ─────────────────────
# ENVIRONMENT=prod requires: DEBUG=false, LOG_LEVEL=INFO (or higher),
# non-default DB_URL/Redis credentials, provider keys for a non-console
# SMS_PROVIDER and EMAIL_PROVIDER, mounted JWT keys, and explicit HTTPS CORS
# origins. See docs/deployment/PRODUCTION_DEPLOYMENT.md.

# ── Host ──────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Tests ─────────────────────────────────────
# The pytest suite truncates every table. Point this at a dedicated database
# whose name ends in "_test"; conftest creates it and runs migrations on it.
# Leave unset to use DB_URL (refused unless it ends in "_test").
TEST_DB_URL=postgresql+asyncpg://oryonfoods:oryonfoods@localhost:5455/oryonfoods_auth_test
# Escape hatch: allows the suite to wipe DB_URL itself. Never set in CI.
# ALLOW_DEV_DB_TESTS=1
